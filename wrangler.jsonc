{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lcc",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./src/static",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Run Worker first so we can inject site data by host
    "run_worker_first": ["/", "/index.html", "/api/*", "/404.html"]
  }
}
